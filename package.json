{
  "name": "my-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && tsx scripts/dev-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply my-finance --remote",
    "db:seed": "wrangler d1 execute my-finance --remote --file db/seed.sql",
    "vapid": "node scripts/gen-vapid.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "wrangler": "^4"
  }
}
